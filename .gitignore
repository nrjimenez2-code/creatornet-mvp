# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test-cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.p8

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Generated capacity measurements and exact temporary fixture journals.
/scripts/outputs/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

.vercel

DELIVERY_CHECKLIST.md
MY_TASKS.md
AUDIT_FIXES.md

# Local / downloaded product briefs (not part of the repo)
CreatorNet_dev_brief.pdf
**/CreatorNet_dev_brief.pdf

# Local SQL â€” applied directly in Supabase SQL editor, no need to track
# Ignore supabase/ CONTENTS rather than the directory itself, so the schema snapshot
# below can be re-included. (Git cannot re-include a path inside an excluded directory.)
supabase/*
# Keep the committed schema snapshot. Before it, the schema existed only in the live
# database, with no migration history and nothing to diff a proposed change against.
!supabase/schema/

# Reviewed Discover migration package; generated CLI state stays ignored.
!supabase/migrations/
supabase/migrations/*
